<script lang="ts">
  import type { <%= @entity_ts %> } from '<%= @types_import %>';
  import type { LiveHandle } from '<%= @types_import %>';

  let {
    <%= @singular %>,
    flash_message = null,
    live
  }: {
    <%= @singular %>: <%= @entity_ts %>;
    flash_message?: string | null;
    live: LiveHandle;
  } = $props();
</script>

{#if flash_message}
  <div class="flash">{flash_message}</div>
{/if}

<article class="<%= @singular %>-show">
  <dl>
<%= for f <- @fields do %>    <dt><%= f.label %></dt>
    <dd><%= f.cell %></dd>
<% end %>  </dl>

  <div class="actions">
    <button onclick={() => live.pushEvent('edit', { id: <%= @singular %>.id })}>Edit</button>
    <button onclick={() => live.pushEvent('back', {})}>Back</button>
  </div>
</article>

