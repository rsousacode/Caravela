<!-- GENERATED by Caravela from <%= @domain_module %> - edit below the CUSTOM marker. <%= @caravela_metadata %> -->
<script lang="ts">
  import type { <%= @entity_ts %>, <%= @field_access_ts %>, LiveHandle } from '<%= @types_import %>';

  let {
    <%= @singular %>,
    flash_message = null,
    field_access = <%= @default_field_access %>,
    live
  }: {
    <%= @singular %>: <%= @entity_ts %>;
    flash_message?: string | null;
    field_access?: <%= @field_access_ts %>;
    live: LiveHandle;
  } = $props();
</script>

{#if flash_message}
  <div class="flash">{flash_message}</div>
{/if}

<article class="<%= @singular %>-show">
  <dl>
<%= for f <- @fields do %><%= if f.gated do %>    {#if field_access.<%= f.name %>}
      <dt><%= f.label %></dt>
      <dd><%= f.cell %></dd>
    {/if}
<% else %>    <dt><%= f.label %></dt>
    <dd><%= f.cell %></dd>
<% end %><% end %>  </dl>

  <div class="actions">
    <button onclick={() => live.pushEvent('edit', { id: <%= @singular %>.id })}>Edit</button>
    <button onclick={() => live.pushEvent('back', {})}>Back</button>
  </div>
</article>

<!-- --- CUSTOM --- -->
