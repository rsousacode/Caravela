<script lang="ts">
  import type { <%= @entity_ts %> } from '<%= @types_import %>';

  export let <%= @singular %>: <%= @entity_ts %>;
  export let flash_message: string | null = null;

  export let pushEvent: (event: string, payload: object) => void;
</script>

{#if flash_message}
  <div class="flash">{flash_message}</div>
{/if}

<article class="<%= @singular %>-show">
  <dl>
<%= for f <- @fields do %>    <dt><%= f.label %></dt>
    <dd><%= f.cell %></dd>
<% end %>  </dl>

  <div class="actions">
    <button on:click={() => pushEvent('edit', { id: <%= @singular %>.id })}>Edit</button>
    <button on:click={() => pushEvent('back', {})}>Back</button>
  </div>
</article>

