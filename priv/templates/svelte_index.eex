<!-- GENERATED by Caravela from <%= @domain_module %> — edit below the CUSTOM marker. -->
<script lang="ts">
  import type { <%= @entity_ts %> } from '<%= @types_import %>';
  import type { LiveHandle } from '<%= @types_import %>';

  // `live` is the LiveSvelte hook ref; call `live.pushEvent(...)` to
  // dispatch events back to the mounting LiveView.
  let {
    <%= @plural %> = [],
    loading = false,
    flash_message = null,
    live
  }: {
    <%= @plural %>?: <%= @entity_ts %>[];
    loading?: boolean;
    flash_message?: string | null;
    live: LiveHandle;
  } = $props();

  function handleDelete(id: string) {
    if (confirm('Delete this <%= @singular %>?')) {
      live.pushEvent('delete', { id });
    }
  }
</script>

{#if flash_message}
  <div class="flash">{flash_message}</div>
{/if}

<div class="toolbar">
  <button onclick={() => live.pushEvent('new', {})}>New <%= @singular %></button>
</div>

{#if loading}
  <div class="loading">Loading…</div>
{:else if <%= @plural %>.length === 0}
  <div class="empty">No <%= @plural %> yet.</div>
{:else}
  <table>
    <thead>
      <tr>
<%= for col <- @columns do %>        <th><%= col.label %></th>
<% end %>        <th></th>
      </tr>
    </thead>
    <tbody>
      {#each <%= @plural %> as <%= @singular %> (<%= @singular %>.id)}
        <tr>
<%= for col <- @columns do %>          <td><%= col.cell %></td>
<% end %>          <td>
            <button onclick={() => live.pushEvent('edit', { id: <%= @singular %>.id })}>Edit</button>
            <button onclick={() => handleDelete(<%= @singular %>.id)}>Delete</button>
          </td>
        </tr>
      {/each}
    </tbody>
  </table>
{/if}

