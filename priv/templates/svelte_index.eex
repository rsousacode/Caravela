<!-- GENERATED by Caravela from <%= @domain_module %> — edit below the CUSTOM marker. <%= @caravela_metadata %> -->
<script lang="ts">
  import type {
    <%= @entity_ts %>,
    <%= @field_access_ts %>,
    <%= @entity_ts %>Actions,
    LiveHandle
  } from '<%= @types_import %>';

  // `live` is the LiveSvelte hook ref; call `live.pushEvent(...)` to
  // dispatch events back to the mounting LiveView.
  //
  // `field_access` carries the per-field visibility decisions from the
  // server-side policy engine — fields the current actor cannot see
  // are gated out of the table entirely.
  //
  // `actions` carries the per-action decisions from the policy engine.
  // Arity-1 gates resolve to booleans; arity-2 gates may resolve to
  // `'per_record'` at the collection level, meaning each row needs a
  // server round-trip (or a custom wrapper) to decide per-record.
  let {
    <%= @plural %> = [],
    loading = false,
    flash_message = null,
    field_access = <%= @default_field_access %>,
    actions = <%= @default_actions %>,
    live
  }: {
    <%= @plural %>?: <%= @entity_ts %>[];
    loading?: boolean;
    flash_message?: string | null;
    field_access?: <%= @field_access_ts %>;
    actions?: <%= @entity_ts %>Actions;
    live: LiveHandle;
  } = $props();

  function handleDelete(id: string) {
    if (confirm('Delete this <%= @singular %>?')) {
      live.pushEvent('delete', { id });
    }
  }
</script>

{#if flash_message}
  <div class="flash">{flash_message}</div>
{/if}

<div class="toolbar">
  {#if actions.create !== false}
    <button onclick={() => live.pushEvent('new', {})}>New <%= @singular %></button>
  {/if}
</div>

{#if loading}
  <div class="loading">Loading…</div>
{:else if <%= @plural %>.length === 0}
  <div class="empty">No <%= @plural %> yet.</div>
{:else}
  <table>
    <thead>
      <tr>
<%= for col <- @columns do %><%= if col.gated do %>        {#if field_access.<%= col.name %>}<th><%= col.label %></th>{/if}
<% else %>        <th><%= col.label %></th>
<% end %><% end %>        <th></th>
      </tr>
    </thead>
    <tbody>
      {#each <%= @plural %> as <%= @singular %> (<%= @singular %>.id)}
        <tr>
<%= for col <- @columns do %><%= if col.gated do %>          {#if field_access.<%= col.name %>}<td><%= col.cell %></td>{/if}
<% else %>          <td><%= col.cell %></td>
<% end %><% end %>          <td>
            {#if actions.update === true}
              <button onclick={() => live.pushEvent('edit', { id: <%= @singular %>.id })}>Edit</button>
            {/if}
            {#if actions.delete === true}
              <button onclick={() => handleDelete(<%= @singular %>.id)}>Delete</button>
            {/if}
          </td>
        </tr>
      {/each}
    </tbody>
  </table>
{/if}

<!-- --- CUSTOM --- -->
