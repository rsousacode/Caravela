<script lang="ts">
  import type { <%= @entity_ts %> } from '<%= @types_import %>';

  // Props pushed from LiveView via LiveSvelte
  export let <%= @plural %>: <%= @entity_ts %>[] = [];
  export let loading: boolean = false;
  export let flash_message: string | null = null;

  // Dispatch events back to LiveView
  export let pushEvent: (event: string, payload: object) => void;

  function handleDelete(id: string) {
    if (confirm('Delete this <%= @singular %>?')) {
      pushEvent('delete', { id });
    }
  }
</script>

{#if flash_message}
  <div class="flash">{flash_message}</div>
{/if}

<div class="toolbar">
  <button on:click={() => pushEvent('new', {})}>New <%= @singular %></button>
</div>

{#if loading}
  <div class="loading">Loading…</div>
{:else if <%= @plural %>.length === 0}
  <div class="empty">No <%= @plural %> yet.</div>
{:else}
  <table>
    <thead>
      <tr>
<%= for col <- @columns do %>        <th><%= col.label %></th>
<% end %>        <th></th>
      </tr>
    </thead>
    <tbody>
      {#each <%= @plural %> as <%= @singular %> (<%= @singular %>.id)}
        <tr>
<%= for col <- @columns do %>          <td><%= col.cell %></td>
<% end %>          <td>
            <button on:click={() => pushEvent('edit', { id: <%= @singular %>.id })}>Edit</button>
            <button on:click={() => handleDelete(<%= @singular %>.id)}>Delete</button>
          </td>
        </tr>
      {/each}
    </tbody>
  </table>
{/if}

