<script lang="ts">
  import type { LiveHandle } from '<%= @types_import %>';

  let {
    status = 'pending',
    message = null,
    live
  }: {
    status?: 'pending' | 'ok' | 'error';
    message?: string | null;
    live: LiveHandle;
  } = $props();
</script>

<section class="auth-form auth-confirm">
  {#if status === 'pending'}
    <h2>Confirming your email…</h2>
  {:else if status === 'ok'}
    <h2>Email confirmed ✓</h2>
    <p>You can now sign in.</p>
    <a class="button" href="<%= @login_path %>">Continue to sign in</a>
  {:else}
    <h2>Confirmation failed</h2>
    <p>{message ?? 'This link is invalid or has expired.'}</p>
    <button onclick={() => live.pushEvent('resend', {})}>Send a new link</button>
  {/if}
</section>

