// GENERATED by Caravela from <%= @domain_module %> — edit below the CUSTOM marker.
//
// TypeScript interfaces for every entity in the domain. Import into
// Svelte components as `import type { <Entity> } from '<relative>/<context>';`.
//
// Regenerate with `mix caravela.gen.live <%= @domain_module %>`.

/**
 * LiveSvelte hook handle injected as the `live` prop of every generated
 * component. Call `live.pushEvent(name, payload)` to dispatch an event
 * to the mounting LiveView.
 */
export interface LiveHandle {
  pushEvent: (
    event: string,
    payload: object,
    cb?: (reply: unknown) => void
  ) => number;
  pushEventTo: (
    target: string,
    event: string,
    payload: object
  ) => number;
  handleEvent: (event: string, cb: (payload: unknown) => void) => void;
}

<%= for e <- @entities do %>export interface <%= e.ts_name %> {
  id: string;
<%= for f <- e.ts_fields do %>  <%= f.name %><%= if f.optional, do: "?" %>: <%= f.ts_type %>;
<% end %>  inserted_at: string;
  updated_at: string;
}

/**
 * Policy-driven field access map for <%= e.ts_name %>. Generated from
 * the `policy` block in the domain DSL. A literal `true` means the
 * field is always visible. A `boolean` means visibility depends on the
 * current actor. `'per_record'` means visibility varies per row — the
 * field will simply be `null` on rows where access is denied.
 */
export interface <%= e.ts_name %>FieldAccess {
<%= for fa <- e.field_access do %>  <%= fa.name %>: <%= fa.ts_type %>;
<% end %>}

<% end %><%= if @authenticated do %>/**
 * The authenticated user injected as `current_user` on every
 * authenticated LiveView / Svelte component. Null on public pages.
 */
export type CurrentUser = <%= @user_ts_name %> | null;

/** A scoped API token issued to a <%= @user_ts_name %>. */
export interface ApiToken {
  id: string;
  scope: <%= @api_token_scopes || "string" %>;
  inserted_at: string;
  expires_at: string;
}

/** An active session for a <%= @user_ts_name %>. */
export interface Session {
  id: string;
  context: string;
  inserted_at: string;
  expires_at: string;
  is_current: boolean;
}

<% end %>// --- CUSTOM ---
// Custom code below this line is preserved on regeneration.
