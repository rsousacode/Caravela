<!-- GENERATED by Caravela from <%= @domain_module %> - edit below the CUSTOM marker. -->
<script lang="ts">
  import type { CurrentUser, LiveHandle, Session } from '<%= @types_import %>';

  let {
    current_user,
    sessions = [],
    loading = false,
    live
  }: {
    current_user: CurrentUser;
    sessions?: Session[];
    loading?: boolean;
    live: LiveHandle;
  } = $props();

  function revoke(id: string) {
    live.pushEvent('revoke_session', { id });
  }

  function revokeOthers() {
    live.pushEvent('revoke_all_others', {});
  }
</script>

<section class="session-list">
  <h3>Active sessions ({sessions.length})</h3>

  <div class="actions">
    <button type="button" onclick={revokeOthers} disabled={loading || sessions.length <= 1}>
      Sign out other sessions
    </button>
  </div>

  {#if sessions.length === 0}
    <p class="empty">No active sessions.</p>
  {:else}
    <table>
      <thead>
        <tr>
          <th>Started</th>
          <th>Expires</th>
          <th>Context</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {#each sessions as session (session.id)}
          <tr class:current={session.is_current}>
            <td>{new Date(session.inserted_at).toLocaleString()}</td>
            <td>{new Date(session.expires_at).toLocaleDateString()}</td>
            <td>{session.context}{session.is_current ? ' (this session)' : ''}</td>
            <td>
              {#if !session.is_current}
                <button type="button" onclick={() => revoke(session.id)}>Revoke</button>
              {/if}
            </td>
          </tr>
        {/each}
      </tbody>
    </table>
  {/if}
</section>

