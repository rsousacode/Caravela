<!-- GENERATED by Caravela from <%= @domain_module %> — edit below the CUSTOM marker. -->
<script lang="ts">
  import type { <%= @entity_ts %> } from '<%= @types_import %>';
  import type { LiveHandle } from '<%= @types_import %>';

  let {
    <%= @singular %> = {},
    errors = {},
    saving = false,
    live
  }: {
    <%= @singular %>?: Partial<<%= @entity_ts %>>;
    errors?: Record<string, string[]>;
    saving?: boolean;
    live: LiveHandle;
  } = $props();

  function handleChange(field: string, value: unknown) {
    live.pushEvent('validate', { field, value });
  }

  function handleSubmit(e: Event) {
    e.preventDefault();
    live.pushEvent('save', {});
  }
</script>

<form onsubmit={handleSubmit}>
<%= for input <- @inputs do %>  <label>
    <%= input.label %><%= if input.required, do: " *" %>
    <%= input.control %>
    {#if errors.<%= input.name %>}
      <span class="error">{errors.<%= input.name %>.join(', ')}</span>
    {/if}
  </label>

<% end %>  <div class="actions">
    <button type="submit" disabled={saving}>
      {saving ? 'Saving…' : 'Save'}
    </button>
    <button type="button" onclick={() => live.pushEvent('cancel', {})} disabled={saving}>
      Cancel
    </button>
  </div>
</form>

<!-- --- CUSTOM --- -->
