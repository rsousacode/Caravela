<!-- GENERATED by Caravela from <%= @domain_module %> - edit below the CUSTOM marker. -->
<!-- Fields derived from the authenticatable entity declaration. -->
<script lang="ts">
  import type { LiveHandle } from '<%= @types_import %>';

  let {
    errors = {},
    loading = false,
    flash_message = null,
    live
  }: {
    errors?: Record<string, string[]>;
    loading?: boolean;
    flash_message?: string | null;
    live: LiveHandle;
  } = $props();

<%= for f <- @fields do %>  let <%= f.var %> = $state(<%= f.initial %>);
<% end %>  let password = $state('');
  let password_confirmation = $state('');

  function handleSubmit(e: Event) {
    e.preventDefault();
    live.pushEvent('register', {
<%= for f <- @fields do %>      <%= f.key %>: <%= f.var %>,
<% end %>      password,
      password_confirmation
    });
  }
</script>

<form class="auth-form" onsubmit={handleSubmit}>
  <h2>Create account</h2>

  {#if flash_message}
    <div class="flash">{flash_message}</div>
  {/if}

<%= for f <- @fields do %>  <label>
    <%= f.label %><%= if f.required, do: " *" %>
    <%= f.control %>
    {#if errors.<%= f.key %>}<span class="error">{errors.<%= f.key %>.join(', ')}</span>{/if}
  </label>

<% end %>  <label>
    Password *
    <input
      type="password"
      autocomplete="new-password"
      required
      minlength="8"
      value={password}
      oninput={(e) => (password = e.currentTarget.value)}
    />
    {#if errors.password}<span class="error">{errors.password.join(', ')}</span>{/if}
  </label>

  <label>
    Confirm password *
    <input
      type="password"
      autocomplete="new-password"
      required
      value={password_confirmation}
      oninput={(e) => (password_confirmation = e.currentTarget.value)}
    />
    {#if errors.password_confirmation}<span class="error">{errors.password_confirmation.join(', ')}</span>{/if}
  </label>

  {#if errors.base}
    <div class="error base-error">{errors.base.join(', ')}</div>
  {/if}

  <button type="submit" disabled={loading}>
    {loading ? 'Creating account…' : 'Create account'}
  </button>

  <nav class="auth-links">
    <a href="<%= @login_path %>">Already have an account?</a>
  </nav>
</form>

<!-- --- CUSTOM --- -->
