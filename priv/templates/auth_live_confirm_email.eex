defmodule <%= inspect @module %> do
  @moduledoc """
  Email-confirmation LiveView generated by Caravela from <%= inspect @domain_module %>.

  Mounts `<%= @component_ref %>` and immediately consumes the `:token`
  path param against `Auth.confirm_email/1`.
  """

  use <%= @web_module_alias %>, :live_view

  alias <%= inspect @auth_module %>, as: Auth

  @impl true
  def mount(%{"token" => token}, _session, socket) do
    {status, message} =
      case Auth.confirm_email(token) do
        {:ok, _user} -> {"ok", nil}
        {:error, reason} -> {"error", humanize_error(reason)}
      end

    {:ok,
     socket
     |> assign(:status, status)
     |> assign(:message, message)}
  end

  def mount(_params, _session, socket) do
    {:ok, assign(socket, status: "error", message: "Missing confirmation token.")}
  end

  @impl true
  def handle_event("resend", _params, socket) do
    {:noreply, put_flash(socket, :info, "If this account exists, a new confirmation link is on its way.")}
  end

  @impl true
  def render(assigns) do
    ~H"""
    <LiveSvelte.svelte
      name="<%= @component_ref %>"
      props={%{status: @status, message: @message}}
      socket={@socket}
    />
    """
  end

  defp humanize_error(atom) when is_atom(atom),
    do: atom |> Atom.to_string() |> String.replace("_", " ")

  defp humanize_error(other), do: inspect(other)

  # --- CUSTOM :auth_live_confirm_email ---
  # --- END :auth_live_confirm_email ---

  <%= @custom_marker %>
