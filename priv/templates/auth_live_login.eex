defmodule <%= inspect @module %> do
  @moduledoc """
  Login LiveView generated by Caravela from <%= inspect @domain_module %>.

  Mounts the `<%= @component_ref %>` Svelte component via LiveSvelte.
  Regenerate with `mix caravela.gen.auth <%= inspect @domain_module %>`.
  Custom code placed below the `# --- CUSTOM ---` marker is preserved.
  """

  use <%= @web_module_alias %>, :live_view

  alias <%= inspect @auth_module %>, as: Auth

  @impl true
  def mount(_params, _session, socket) do
    {:ok,
     socket
     |> assign(:errors, %{})
     |> assign(:loading, false)
     |> assign(:flash_message, nil)}
  end

  @impl true
  def handle_event("login", %{"email" => email, "password" => password} = params, socket) do
    socket = assign(socket, loading: true, errors: %{})
    remember_me = Map.get(params, "remember_me", false) == true
    context = request_context(socket)

    case Auth.login(email, password, context) do
      {:ok, _user, token} ->
        encoded = Base.url_encode64(token, padding: false)

        {:noreply,
         socket
         |> assign(:loading, false)
         |> push_event("caravela:store_session_token", %{token: encoded, remember_me: remember_me})
         |> push_navigate(to: "<%= @after_login_path %>")}

      {:error, reason} ->
        {:noreply,
         socket
         |> assign(:loading, false)
         |> assign(:errors, %{base: [humanize_error(reason)]})}
    end
  end

  @impl true
  def render(assigns) do
    ~H"""
    <LiveSvelte.svelte
      name="<%= @component_ref %>"
      props={%{
        errors: @errors,
        loading: @loading,
        flash_message: @flash_message
      }}
      socket={@socket}
    />
    """
  end

  defp request_context(socket) do
    %{
      current_user: nil<%= if @multi_tenant do %>,
      tenant_id: socket.assigns[:tenant_id]<% end %>
    }
  end

  defp humanize_error(:invalid_credentials), do: "Invalid email or password"
  defp humanize_error(:unconfirmed_email), do: "Please confirm your email first"
  defp humanize_error(:suspended), do: "This account is suspended"
  defp humanize_error(other), do: other |> Atom.to_string() |> String.replace("_", " ")

  <%= @custom_marker %>
