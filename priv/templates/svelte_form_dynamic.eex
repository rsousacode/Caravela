<!-- GENERATED by Caravela from <%= @form_module %> — edit below the CUSTOM marker. -->
<script lang="ts">
  import type { <%= @entity_ts %> } from '<%= @types_import %>';
  import type { LiveHandle } from '<%= @types_import %>';

  // Props from LiveView (server state). `live` is the LiveSvelte hook ref.
  let {
    <%= @singular %> = {},
    errors = {},
    saving = false,
    field_visibility = {},
    async_errors = {},
    live
  }: {
    <%= @singular %>?: Partial<<%= @entity_ts %>>;
    errors?: Record<string, string[]>;
    saving?: boolean;
    field_visibility?: Record<string, boolean>;
    async_errors?: Record<string, string | null>;
    live: LiveHandle;
  } = $props();
<%= for {field, _debounce} <- @async_fields do %>  let <%= field %>Timer: ReturnType<typeof setTimeout>;
<% end %>
  function handleChange(field: string, value: unknown) {
    live.pushEvent('validate', { field, value });
<%= for {field, debounce} <- @async_fields do %>
    if (field === '<%= field %>') {
      clearTimeout(<%= field %>Timer);
      <%= field %>Timer = setTimeout(() => {
        live.pushEvent('validate_async', { field: '<%= field %>', value });
      }, <%= debounce %>);
    }
<% end %>  }

  function handleSubmit(e: Event) {
    e.preventDefault();
    live.pushEvent('save', {});
  }
</script>

<form onsubmit={handleSubmit}>
<%= for input <- @inputs do %><%= if input.visible? do %>  {#if field_visibility.<%= input.name %>}
    <label>
      <%= input.label %><%= if input.required, do: " *" %>
      <%= input.control %>
      {#if errors.<%= input.name %>}
        <span class="error">{errors.<%= input.name %>.join(', ')}</span>
      {/if}<%= if input.async? do %>
      {#if async_errors.<%= input.name %>}
        <span class="error async">{async_errors.<%= input.name %>}</span>
      {/if}<% end %>
    </label>
  {/if}
<% else %>  <label>
    <%= input.label %><%= if input.required, do: " *" %>
    <%= input.control %>
    {#if errors.<%= input.name %>}
      <span class="error">{errors.<%= input.name %>.join(', ')}</span>
    {/if}<%= if input.async? do %>
    {#if async_errors.<%= input.name %>}
      <span class="error async">{async_errors.<%= input.name %>}</span>
    {/if}<% end %>
  </label>
<% end %>
<% end %>  <div class="actions">
    <button type="submit" disabled={saving}>
      {saving ? 'Saving…' : 'Save'}
    </button>
    <button type="button" onclick={() => live.pushEvent('cancel', {})} disabled={saving}>
      Cancel
    </button>
  </div>
</form>

<!-- --- CUSTOM --- -->
