defmodule <%= inspect @module %> do
  @moduledoc """
  Generated by Caravela from <%= inspect @domain_module %>.

  LiveView that mounts the `<%= @component_ref %>` Svelte component via
  LiveSvelte. List page for `<%= @plural %>`: renders the collection,
  handles delete, and navigates to the edit route on the `edit` event.

  Regenerate with `mix caravela.gen.live <%= inspect @domain_module %>`.
  Custom code placed below the `# --- CUSTOM ---` marker is preserved.
  """

  use <%= @web_module_alias %>, :live_view

  alias <%= inspect @context_module %>

  @impl true
  def mount(_params, _session, socket) do
    context = build_context(socket)

    socket =
      socket
      |> assign(:context, context)
      |> assign(:loading, false)
      |> assign(:flash_message, nil)
      |> assign(:field_access, <%= @context_short %>.field_access(<%= inspect @entity_name %>, context))
      |> assign(:<%= @plural %>, <%= @context_short %>.<%= @list_fn %>(context))

    {:ok, socket}
  end

  @impl true
  def handle_event("delete", %{"id" => id}, socket) do
    context = socket.assigns.context

    case <%= @context_short %>.<%= @delete_fn %>(id, context) do
      {:ok, _} ->
        {:noreply,
         socket
         |> assign(:flash_message, "Deleted")
         |> assign(:<%= @plural %>, <%= @context_short %>.<%= @list_fn %>(context))}

      {:error, :not_found} ->
        {:noreply, assign(socket, :flash_message, "Not found")}

      {:error, :unauthorized} ->
        {:noreply, assign(socket, :flash_message, "Not authorized")}

      {:error, reason} ->
        {:noreply, assign(socket, :flash_message, "Error: " <> inspect(reason))}
    end
  end

  def handle_event("edit", %{"id" => id}, socket) do
    {:noreply, push_navigate(socket, to: "<%= @edit_path %>" <> id <> "/edit")}
  end

  def handle_event("new", _params, socket) do
    {:noreply, push_navigate(socket, to: "<%= @new_path %>")}
  end

  @impl true
  def render(assigns) do
    ~H"""
    <LiveSvelte.svelte
      name="<%= @component_ref %>"
      props={%{
        <%= @plural %>: @<%= @plural %>,
        loading: @loading,
        flash_message: @flash_message,
        field_access: @field_access
      }}
      socket={@socket}
    />
    """
  end

  # --- Internal --------------------------------------------------------

  defp build_context(socket) do
    %{
      current_user: socket.assigns[:current_user]<%= if @multi_tenant do %>,
      tenant: socket.assigns[:tenant]<% end %>
    }
  end

  <%= @custom_marker %>
