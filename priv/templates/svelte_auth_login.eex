<!-- GENERATED by Caravela from <%= @domain_module %> — edit below the CUSTOM marker. -->
<script lang="ts">
  import type { LiveHandle } from '<%= @types_import %>';

  let {
    errors = {},
    loading = false,
    flash_message = null,
    live
  }: {
    errors?: Record<string, string[]>;
    loading?: boolean;
    flash_message?: string | null;
    live: LiveHandle;
  } = $props();

  let email = $state('');
  let password = $state('');
  let remember_me = $state(false);

  function handleSubmit(e: Event) {
    e.preventDefault();
    live.pushEvent('login', { email, password, remember_me });
  }
</script>

<form class="auth-form" onsubmit={handleSubmit}>
  <h2>Sign in</h2>

  {#if flash_message}
    <div class="flash">{flash_message}</div>
  {/if}

  <label>
    Email
    <input
      type="email"
      autocomplete="email"
      required
      value={email}
      oninput={(e) => (email = e.currentTarget.value)}
    />
    {#if errors.email}<span class="error">{errors.email.join(', ')}</span>{/if}
  </label>

  <label>
    Password
    <input
      type="password"
      autocomplete="current-password"
      required
      value={password}
      oninput={(e) => (password = e.currentTarget.value)}
    />
    {#if errors.password}<span class="error">{errors.password.join(', ')}</span>{/if}
  </label>
<%= if @remember_me? do %>
  <label class="checkbox">
    <input
      type="checkbox"
      checked={remember_me}
      onchange={(e) => (remember_me = e.currentTarget.checked)}
    />
    Remember me for <%= @remember_me_days %> days
  </label>
<% end %>
  {#if errors.base}
    <div class="error base-error">{errors.base.join(', ')}</div>
  {/if}

  <button type="submit" disabled={loading}>
    {loading ? 'Signing in…' : 'Sign in'}
  </button>

  <nav class="auth-links">
    <a href="<%= @register_path %>">Create account</a>
<%= if @reset? do %>    <a href="<%= @reset_path %>">Forgot password?</a>
<% end %>  </nav>
</form>

<!-- --- CUSTOM --- -->
