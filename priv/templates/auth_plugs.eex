defmodule <%= inspect @module %> do
  @moduledoc """
  Authentication plugs generated by Caravela from <%= inspect @domain_module %>.

  Regenerate with `mix caravela.gen.auth <%= inspect @domain_module %>`.
  Custom code placed below the `# --- CUSTOM ---` marker is preserved.
  """
  import Plug.Conn

  alias <%= inspect @auth_module %>, as: Auth

  def fetch_current_user(conn, _opts) do
    session_token = get_session(conn, :user_token)
    bearer_token = get_bearer_token(conn)

    cond do
      user = session_token && Auth.get_user_by_session(session_token) ->
        assign(conn, :current_user, user)

      bearer_token && match?({:ok, _}, Auth.verify_api_token(bearer_token)) ->
        {:ok, %{user: user, scope: scope}} = Auth.verify_api_token(bearer_token)

        conn
        |> assign(:current_user, user)
        |> assign(:token_scope, scope)

      true ->
        conn
        |> assign(:current_user, nil)
        |> assign(:token_scope, nil)
    end
  end

  def require_auth(conn, _opts) do
    if conn.assigns[:current_user] do
      conn
    else
      conn
      |> put_status(401)
      |> Phoenix.Controller.json(%{error: "unauthorized"})
      |> halt()
    end
  end

  def require_role(conn, roles) when is_list(roles) do
    user = conn.assigns[:current_user]

    if user && user.role in roles do
      conn
    else
      conn
      |> put_status(403)
      |> Phoenix.Controller.json(%{error: "forbidden"})
      |> halt()
    end
  end

  def require_role(conn, role) when is_atom(role), do: require_role(conn, [role])

  def require_scope(conn, scopes) when is_list(scopes) do
    if conn.assigns[:token_scope] in scopes do
      conn
    else
      conn
      |> put_status(403)
      |> Phoenix.Controller.json(%{error: "forbidden"})
      |> halt()
    end
  end

  defp get_bearer_token(conn) do
    case get_req_header(conn, "authorization") do
      ["Bearer " <> token] -> token
      _ -> nil
    end
  end

  <%= @custom_marker %>
