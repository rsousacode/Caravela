<!-- GENERATED by Caravela from <%= @domain_module %> - edit below the CUSTOM marker. -->
<script lang="ts">
  import type { ApiToken, CurrentUser, LiveHandle } from '<%= @types_import %>';

  let {
    current_user,
    tokens = [],
    new_token = null,
    errors = {},
    loading = false,
    live
  }: {
    current_user: CurrentUser;
    tokens?: ApiToken[];
    new_token?: string | null;
    errors?: Record<string, string[]>;
    loading?: boolean;
    live: LiveHandle;
  } = $props();

  const MAX_TOKENS = <%= @max_tokens %>;
  const SCOPES = <%= @scopes_literal %> as const;
  type Scope = (typeof SCOPES)[number];

  let scope = $state<Scope>(SCOPES[0]);

  let at_limit = $derived(tokens.length >= MAX_TOKENS);

  function createToken(e: Event) {
    e.preventDefault();
    live.pushEvent('create_token', { scope });
  }

  function revokeToken(id: string) {
    live.pushEvent('revoke_token', { id });
  }

  function copyToken() {
    if (new_token) navigator.clipboard?.writeText(new_token);
  }
</script>

<section class="token-manager">
  <h3>API tokens ({tokens.length}/{MAX_TOKENS})</h3>

  {#if new_token}
    <div class="token-created">
      <strong>Copy your token now - we'll never show it again:</strong>
      <code>{new_token}</code>
      <button type="button" onclick={copyToken}>Copy</button>
    </div>
  {/if}

  <form onsubmit={createToken}>
    <label>
      Scope
      <select value={scope} onchange={(e) => (scope = e.currentTarget.value as Scope)}>
        {#each SCOPES as s}
          <option value={s}>{s}</option>
        {/each}
      </select>
    </label>

    <button type="submit" disabled={loading || at_limit}>
      {loading ? 'Creating…' : 'Create token'}
    </button>
  </form>

  {#if errors.base}<div class="error">{errors.base.join(', ')}</div>{/if}

  {#if tokens.length === 0}
    <p class="empty">No tokens yet.</p>
  {:else}
    <table>
      <thead>
        <tr>
          <th>Scope</th>
          <th>Created</th>
          <th>Expires</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {#each tokens as token (token.id)}
          <tr>
            <td><span class="badge">{token.scope}</span></td>
            <td>{new Date(token.inserted_at).toLocaleDateString()}</td>
            <td>{new Date(token.expires_at).toLocaleDateString()}</td>
            <td>
              <button type="button" onclick={() => revokeToken(token.id)}>Revoke</button>
            </td>
          </tr>
        {/each}
      </tbody>
    </table>
  {/if}
</section>

<!-- --- CUSTOM --- -->
