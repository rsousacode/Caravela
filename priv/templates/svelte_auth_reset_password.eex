<!-- GENERATED by Caravela from <%= @domain_module %> — edit below the CUSTOM marker. -->
<script lang="ts">
  import type { LiveHandle } from '<%= @types_import %>';

  /**
   * Two-phase component: when `mode === 'request'` it asks for the
   * email to send a reset link; when `mode === 'confirm'` it collects
   * a new password using the `token` from the URL.
   */
  let {
    mode = 'request',
    token = null,
    errors = {},
    loading = false,
    sent = false,
    flash_message = null,
    live
  }: {
    mode?: 'request' | 'confirm';
    token?: string | null;
    errors?: Record<string, string[]>;
    loading?: boolean;
    sent?: boolean;
    flash_message?: string | null;
    live: LiveHandle;
  } = $props();

  let email = $state('');
  let password = $state('');
  let password_confirmation = $state('');

  function requestReset(e: Event) {
    e.preventDefault();
    live.pushEvent('request_reset', { email });
  }

  function submitNewPassword(e: Event) {
    e.preventDefault();
    live.pushEvent('reset_password', { token, password, password_confirmation });
  }
</script>

<section class="auth-form">
  {#if flash_message}
    <div class="flash">{flash_message}</div>
  {/if}

  {#if mode === 'request'}
    <h2>Reset your password</h2>

    {#if sent}
      <p>If an account matches that email, a reset link is on its way.</p>
      <a href="<%= @login_path %>">Back to sign in</a>
    {:else}
      <form onsubmit={requestReset}>
        <label>
          Email
          <input
            type="email"
            autocomplete="email"
            required
            value={email}
            oninput={(e) => (email = e.currentTarget.value)}
          />
          {#if errors.email}<span class="error">{errors.email.join(', ')}</span>{/if}
        </label>

        <button type="submit" disabled={loading}>
          {loading ? 'Sending…' : 'Send reset link'}
        </button>
      </form>
    {/if}
  {:else}
    <h2>Set a new password</h2>

    <form onsubmit={submitNewPassword}>
      <label>
        New password
        <input
          type="password"
          autocomplete="new-password"
          minlength="8"
          required
          value={password}
          oninput={(e) => (password = e.currentTarget.value)}
        />
        {#if errors.password}<span class="error">{errors.password.join(', ')}</span>{/if}
      </label>

      <label>
        Confirm new password
        <input
          type="password"
          autocomplete="new-password"
          required
          value={password_confirmation}
          oninput={(e) => (password_confirmation = e.currentTarget.value)}
        />
        {#if errors.password_confirmation}
          <span class="error">{errors.password_confirmation.join(', ')}</span>
        {/if}
      </label>

      {#if errors.token}<div class="error base-error">{errors.token.join(', ')}</div>{/if}

      <button type="submit" disabled={loading}>
        {loading ? 'Saving…' : 'Save password'}
      </button>
    </form>
  {/if}
</section>

<!-- --- CUSTOM --- -->
